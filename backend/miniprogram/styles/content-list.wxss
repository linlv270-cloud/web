.content-list-page { background-color: var(--night); color: var(--on-dark); overflow-x: hidden; }
.content-list { width: 100%; max-width: 100%; min-height: 100vh; padding: 0 var(--layout-page-gutter) 88rpx; overflow-x: hidden; }

.content-operation-tabs { width: 100%; padding-top: var(--space-8); display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--space-1); }
.content-operation-tabs button { min-width: 0; height: 132rpx; padding: 12rpx 2rpx; border: 1rpx solid var(--dark-hairline); border-radius: var(--radius-default); display: grid; place-items: center; align-content: center; gap: 10rpx; background: var(--glass-dark); color: var(--dark-text-soft); font-size: var(--type-micro); line-height: var(--line-micro); font-weight: var(--weight-body); white-space: normal; }
.content-operation-tabs button.active { border-color: var(--glass-strong); background: var(--glass-strong); color: var(--accent-pressed); font-weight: var(--weight-body); }
.content-operation-icon { width: 40rpx; height: 40rpx; }

.content-list-context { min-height: 118rpx; display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
.content-list-context > text { color: var(--dark-text-soft); font-size: var(--type-micro); }
.content-filter-button { min-height: var(--layout-touch-target); padding: 0; border: 0; display: flex; align-items: center; gap: 9rpx; background: transparent; color: var(--dark-text-soft); font-size: var(--type-caption); }
.content-filter-icon { width: 34rpx; height: 34rpx; }
.content-filter-count { min-width: 34rpx; height: 34rpx; padding: 0 8rpx; border-radius: var(--radius-pill); display: grid; place-items: center; background: var(--highlight); color: var(--on-dark); font-size: var(--type-micro); }
.content-poster-grid { width: 100%; max-width: 100%; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3) var(--space-2); overflow: hidden; }
.content-grid-card { min-width: 0; }
.content-inline-empty { min-height: 260rpx; padding: 60rpx 20rpx; display: grid; place-items: center; color: var(--dark-text-soft); font-size: var(--type-caption); line-height: var(--line-caption); text-align: center; }

.content-city-empty { min-height: 600rpx; padding: 70rpx var(--space-4); border: 1rpx solid var(--dark-hairline); border-radius: var(--radius-default); display: grid; place-items: center; align-content: center; gap: var(--space-3); background: var(--glass-dark); text-align: center; }
.content-city-empty > text { color: var(--dark-text-soft); font-size: var(--type-caption); }
.content-city-empty > strong { max-width: 520rpx; color: var(--on-dark); font-family: var(--font-editorial); font-size: var(--type-card); line-height: var(--line-card); font-weight: var(--weight-card); }
.content-primary-action, .content-secondary-action { width: min(100%, 520rpx); min-height: 92rpx; border-radius: var(--radius-default); font-size: var(--type-body); font-weight: var(--weight-card); }
.content-primary-action { border: 1rpx solid var(--surface); background: var(--surface); color: var(--accent-pressed); }
.content-secondary-action { border: 1rpx solid var(--dark-hairline); background: transparent; color: var(--on-dark); }

.content-filter-backdrop { position: fixed; z-index: 10000; inset: 0; display: flex; align-items: flex-end; background: var(--scrim); }
.content-filter-sheet { width: 100%; max-height: 88vh; padding: 12rpx var(--layout-page-gutter) calc(24rpx + env(safe-area-inset-bottom)); border-radius: var(--radius-modal) var(--radius-modal) 0 0; display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; background: var(--paper); box-shadow: none; }
.content-sheet-handle { width: 70rpx; height: 7rpx; margin: 2rpx auto 16rpx; border-radius: var(--radius-sm); background: var(--line-strong); }
.content-sheet-heading { min-height: 104rpx; display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); border-bottom: 1rpx solid var(--line); }
.content-sheet-heading > view { display: grid; gap: 5rpx; }
.content-sheet-heading text { color: var(--muted); font-size: var(--type-micro); }
.content-sheet-heading strong { color: var(--ink); font-family: var(--font-editorial); font-size: var(--type-section); line-height: var(--line-section); font-weight: var(--weight-section); }
.content-sheet-close { width: var(--layout-touch-target); height: var(--layout-touch-target); border: 1rpx solid var(--line); border-radius: var(--radius-circle); background: var(--surface); color: var(--text); }
.content-sheet-close image { width: 34rpx; height: 34rpx; }
.content-sheet-scroll { max-height: 58vh; }
.content-filter-group { padding: 28rpx 0; border-bottom: 1rpx solid var(--line); display: grid; gap: 18rpx; }
.content-filter-group > text { color: var(--ink); font-size: var(--type-card); line-height: var(--line-card); font-weight: var(--weight-card); }
.content-filter-options { display: flex; flex-wrap: wrap; gap: 13rpx; }
.content-filter-options button, .content-date-option { min-height: 70rpx; padding: 13rpx 20rpx; border: 1rpx solid var(--line-strong); border-radius: var(--radius-default); background: var(--surface); color: var(--text); font-size: var(--type-caption); line-height: 1.3; }
.content-filter-options button.active { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-pressed); }
.content-date-option { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.content-date-option picker { flex: 1; }
.content-date-option button { min-height: 50rpx; padding: 0 10rpx; border: 0; background: transparent; color: var(--accent); font-size: var(--type-micro); }
.content-sheet-actions { padding-top: 22rpx; display: grid; grid-template-columns: .8fr 1.2fr; gap: 16rpx; }
.content-sheet-actions button { min-height: 92rpx; border-radius: var(--radius-default); font-size: var(--type-body); font-weight: var(--weight-card); }
.content-sheet-secondary { border: 1rpx solid var(--line-strong); background: var(--surface); color: var(--text); }
.content-sheet-primary { border: 1rpx solid var(--accent); background: var(--accent); color: var(--on-accent); }
