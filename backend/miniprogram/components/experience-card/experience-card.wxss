.experience-card {
  width: 100%;
  padding: 24rpx;
  border: 1rpx solid var(--line);
  border-radius: var(--radius-default);
  background: var(--surface);
  color: var(--ink);
  text-align: left;
  box-shadow: none;
}
.experience-card::after { border: 0; }
.self-layout, .creator-copy { min-width: 0; display: grid; gap: 9rpx; }
.card-title { display: block; color: var(--ink); font-size: var(--type-card); line-height: var(--line-card); font-weight: var(--weight-card); }
.card-description { display: block; color: var(--muted); font-size: var(--type-secondary); line-height: var(--line-secondary); font-weight: var(--weight-body); }
.card-byline { display: block; color: var(--muted); font-size: var(--type-secondary); line-height: var(--line-secondary); font-weight: var(--weight-body); }
.card-tags { display: flex; flex-wrap: wrap; gap: 10rpx; margin-top: 9rpx; }
.card-tag { min-height: 48rpx; padding: 8rpx 14rpx; border: 1rpx solid var(--line-strong); border-radius: var(--radius-default); background: var(--surface); color: var(--muted); display: flex; align-items: center; font-size: var(--type-micro); line-height: 1.2; white-space: nowrap; }
.card-tag.green { color: var(--success); border-color: var(--success-soft); background: var(--success-soft); }
.card-tag.blue { color: var(--info); border-color: var(--info-soft); background: var(--info-soft); }
.card-facts { display: grid; gap: 14rpx; margin-top: 25rpx; }
.card-facts > view { display: grid; grid-template-columns: 150rpx 1fr; align-items: start; gap: 16rpx; }
.card-facts text { color: var(--muted); font-size: var(--type-caption); line-height: 1.35; font-weight: var(--weight-semibold); }
.card-facts strong { justify-self: end; max-width: 100%; font-size: var(--type-body); line-height: 1.35; font-weight: var(--weight-semibold); text-align: right; overflow-wrap: anywhere; }
.card-actions { min-height: 72rpx; margin-top: 18rpx; display: grid; grid-template-columns: 1fr auto; align-items: end; }
.card-action { min-height: 62rpx; padding: 12rpx 20rpx; border: 1rpx solid var(--line-strong); border-radius: var(--radius-default); background: var(--success-soft); color: var(--ink); display: flex; align-items: center; justify-content: center; font-size: var(--type-secondary); line-height: 1.2; font-weight: var(--weight-semibold); }
.creator-layout { display: grid; grid-template-columns: 116rpx 1fr; gap: 24rpx; }
.creator-avatar { width: 116rpx; height: 116rpx; overflow: hidden; border: 1rpx solid var(--line); border-radius: var(--radius-default); display: grid; place-items: center; background: var(--warning-soft); color: var(--warning); box-shadow: none; font-size: var(--type-card); font-weight: var(--weight-card); }
.creator-avatar image { width: 100%; height: 100%; }
.companion .card-actions { min-height: 68rpx; margin-top: 12rpx; }
.compact { padding: 22rpx; }
.compact .card-facts { margin-top: 20rpx; }
