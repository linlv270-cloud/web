.content-home {
  background-color: var(--night);
  background-image: url("/assets/backgrounds/new1-city-in-motion.jpg");
  color: var(--on-dark);
}

.home-content {
  width: 100%;
  max-width: 100%;
  min-height: 100vh;
  padding: 0 var(--layout-page-gutter) 88rpx;
  overflow-x: hidden;
}

.discovery-filters {
  width: 100%;
  padding-top: var(--space-8);
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));
  gap: var(--space-1);
}

.discovery-filters button {
  min-width: 0;
  height: 132rpx;
  padding: 12rpx 2rpx;
  border: 1rpx solid var(--dark-hairline);
  border-radius: var(--radius-default);
  display: grid;
  place-items: center;
  align-content: center;
  gap: 10rpx;
  background: var(--glass-dark);
  color: var(--dark-text-soft);
  font-size: var(--type-micro);
  line-height: var(--line-micro);
  font-weight: var(--weight-body);
  white-space: normal;
}

.discovery-filters button.active { border-color: var(--glass-strong); background: var(--glass-strong); color: var(--accent-pressed); }
.operation-icon { width: 40rpx; height: 40rpx; }
.content-section { margin-top: var(--space-10); }
.featured-section { margin-top: var(--space-8); }

.section-heading {
  min-height: 52rpx;
  margin-bottom: var(--space-3);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-3);
}

.section-heading > text { color: var(--on-dark); font-family: var(--font-editorial); font-size: var(--type-section); line-height: var(--line-section); font-weight: var(--weight-section); }
.section-heading button { min-height: var(--layout-touch-target); padding: 0; border: 0; display: flex; align-items: center; gap: 9rpx; background: transparent; color: var(--dark-text-soft); font-size: var(--type-secondary); line-height: var(--line-secondary); }
.filter-icon { width: 34rpx; height: 34rpx; }
.filter-count { min-width: 34rpx; height: 34rpx; padding: 0 8rpx; border-radius: var(--radius-pill); display: grid; place-items: center; background: var(--highlight); color: var(--on-dark); font-size: var(--type-micro); }

.featured-viewport { display: block; width: 100%; max-width: 100%; overflow: hidden; touch-action: pan-x pan-y; }
.featured-track { display: flex; width: max-content; max-width: none; padding: 0 0 var(--space-2); gap: var(--space-3); }
.featured-card-wrap { width: 520rpx; min-width: 520rpx; max-width: 72vw; flex: 0 0 520rpx; }
.featured-card-wrap:last-child { margin-right: var(--space-1); }

.quick-filters { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--space-2); }
.quick-filters button { min-width: 0; height: 140rpx; padding: 14rpx 2rpx; border: 1rpx solid var(--dark-hairline); border-radius: var(--radius-default); display: grid; place-items: center; align-content: center; gap: 10rpx; background: var(--glass-dark); color: var(--dark-text-soft); font-size: var(--type-caption); line-height: var(--line-caption); }
.quick-filters button.active { border-color: var(--glass-strong); background: var(--glass-strong); color: var(--accent-pressed); }
.quick-icon { width: 40rpx; height: 40rpx; }
.poster-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-3) var(--space-2); }
.grid-card { min-width: 0; }

.inline-empty { min-height: 200rpx; padding: 50rpx 20rpx; display: grid; place-items: center; color: var(--dark-text-soft); font-size: var(--type-caption); text-align: center; }
.city-empty { min-height: 600rpx; margin-top: var(--space-8); padding: var(--space-8) var(--space-4); border: 1rpx solid var(--dark-hairline); border-radius: var(--radius-default); display: grid; place-items: center; align-content: center; gap: var(--space-3); background: var(--glass-dark); text-align: center; }
.city-empty > text { color: var(--dark-text-soft); font-size: var(--type-caption); }
.city-empty > strong { max-width: 520rpx; color: var(--on-dark); font-family: var(--font-editorial); font-size: var(--type-card); line-height: var(--line-card); font-weight: var(--weight-card); }
.primary-action, .secondary-action { width: min(100%, 520rpx); min-height: 92rpx; border-radius: var(--radius-default); font-size: var(--type-body); font-weight: var(--weight-card); }
.primary-action { border: 1rpx solid var(--surface); background: var(--surface); color: var(--accent-pressed); }
.secondary-action { border: 1rpx solid var(--dark-hairline); background: transparent; color: var(--on-dark); }

.filter-backdrop { position: fixed; z-index: 10000; inset: 0; display: flex; align-items: flex-end; background: var(--scrim); }
.filter-sheet { width: 100%; max-height: 88vh; padding: 12rpx var(--layout-page-gutter) calc(24rpx + env(safe-area-inset-bottom)); border-radius: var(--radius-modal) var(--radius-modal) 0 0; display: grid; grid-template-rows: auto auto minmax(0, 1fr) auto; background: var(--paper); box-shadow: none; }
.sheet-handle { width: 70rpx; height: 7rpx; margin: 2rpx auto 16rpx; border-radius: var(--radius-sm); background: var(--line-strong); }
.sheet-heading { min-height: 104rpx; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; border-bottom: 1rpx solid var(--line); }
.sheet-heading > view { display: grid; gap: 5rpx; }
.sheet-heading text { color: var(--muted); font-size: var(--type-micro); }
.sheet-heading strong { color: var(--ink); font-family: var(--font-editorial); font-size: var(--type-section); line-height: var(--line-section); font-weight: var(--weight-section); }
.sheet-heading > button { width: var(--layout-touch-target); height: var(--layout-touch-target); border: 1rpx solid var(--line); border-radius: var(--radius-circle); background: var(--surface); color: var(--text); }
.sheet-heading > button image { width: 34rpx; height: 34rpx; }
.sheet-scroll { max-height: 58vh; }
.filter-group { padding: 28rpx 0; border-bottom: 1rpx solid var(--line); display: grid; gap: 18rpx; }
.filter-group > text { color: var(--ink); font-size: var(--type-card); line-height: var(--line-card); font-weight: var(--weight-card); }
.filter-options { display: flex; flex-wrap: wrap; gap: 13rpx; }
.filter-options button, .date-option { min-height: 70rpx; padding: 13rpx 20rpx; border: 1rpx solid var(--line-strong); border-radius: var(--radius-default); background: var(--surface); color: var(--text); font-size: var(--type-caption); line-height: 1.3; }
.filter-options button.active { border-color: var(--accent); background: var(--accent-soft); color: var(--accent-pressed); }
.date-option { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.date-option picker { flex: 1; }
.date-option button { min-height: 50rpx; padding: 0 10rpx; border: 0; background: transparent; color: var(--accent); font-size: var(--type-micro); }
.sheet-actions { padding-top: 22rpx; display: grid; grid-template-columns: .8fr 1.2fr; gap: 16rpx; }
.sheet-actions button { min-height: 92rpx; border-radius: var(--radius-default); font-size: var(--type-body); font-weight: var(--weight-card); }
.sheet-secondary { border: 1rpx solid var(--line-strong); background: var(--surface); color: var(--text); }
.sheet-primary { border: 1rpx solid var(--accent); background: var(--accent); color: var(--on-accent); }
