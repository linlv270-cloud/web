.legal-page { min-height: 100vh; background: var(--paper); }
.legal-topbar { min-height: 128rpx; padding: 18rpx var(--layout-page-gutter) 26rpx; border-bottom: 1rpx solid var(--line); display: grid; grid-template-columns: 72rpx minmax(0, 1fr); align-items: center; gap: 18rpx; background: var(--surface-translucent); }
.legal-topbar button { width: 64rpx; height: 64rpx; margin: 0; padding: 0; border: 1rpx solid var(--line); border-radius: var(--radius-circle); background: var(--surface); color: var(--ink); }
.legal-topbar button::after { border: 0; }
.legal-topbar button image { width: 34rpx; height: 34rpx; }
.legal-topbar view { min-width: 0; display: grid; gap: 7rpx; }
.legal-topbar view text:first-child { color: var(--ink); font-size: var(--type-section); line-height: var(--line-section); font-weight: var(--weight-section); }
.legal-topbar view text:last-child { color: var(--ink-soft); font-size: var(--type-micro); line-height: 1.3; }
.legal-content { padding: 16rpx var(--layout-page-gutter) calc(170rpx + env(safe-area-inset-bottom)); }
.legal-section { padding: 34rpx 0; border-bottom: 1rpx solid var(--line); display: grid; gap: 16rpx; }
.legal-section text:first-child { color: var(--ink); font-size: var(--type-body); line-height: 1.5; font-weight: var(--weight-semibold); }
.legal-section text:last-child { color: var(--text); font-size: var(--type-secondary); line-height: 1.85; white-space: pre-wrap; }
