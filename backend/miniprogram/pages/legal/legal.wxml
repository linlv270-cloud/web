<view class="page legal-page">
  <brand-header compact />
  <view class="legal-topbar"><button bindtap="back" aria-label="返回"><image src="/assets/icons/chevron-left-ink.svg" mode="aspectFit"/></button><view><text class="serif">{{title}}</text><text>{{version}} · 更新于{{updatedAt}}</text></view></view>
  <view class="legal-content">
    <view wx:for="{{sections}}" wx:key="title" class="legal-section">
      <text>{{item.title}}</text>
      <text>{{item.body}}</text>
    </view>
  </view>
  <consumer-tabs active="mine" />
</view>
