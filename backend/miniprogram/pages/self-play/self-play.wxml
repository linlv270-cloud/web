<view class="page content-list-page self-list-page atmosphere-page">
  <brand-header immersive show-city city-label="{{cityText}}" city-columns="{{cityColumns}}" city-indexes="{{cityIndexes}}" bind:citycolumnchange="cityColumnChange" bind:citychange="selectCity" />
  <view class="content-list">
    <view class="content-operation-tabs"><button wx:for="{{operationTabs}}" wx:key="value" class="{{operation === item.value ? 'active' : ''}}" data-value="{{item.value}}" bindtap="selectOperation"><image class="content-operation-icon" src="{{operation === item.value ? item.activeIcon : item.icon}}" mode="aspectFit"/><text>{{item.label}}</text></button></view>
    <view wx:if="{{!loading && allCards.length}}" class="content-list-context"><text>营业时间内自在体验</text><button class="content-filter-button" bindtap="openFilter"><image class="content-filter-icon" src="/assets/icons/filter-light.svg" mode="aspectFit"/><text>更多探索</text><text wx:if="{{filterCount}}" class="content-filter-count">{{filterCount}}</text></button></view>
    <view wx:if="{{!loading && cards.length}}" class="content-poster-grid"><view wx:for="{{cards}}" wx:key="key" class="content-grid-card"><poster-card card="{{item}}" bind:open="openCard" /></view></view>
    <view wx:if="{{!loading && allCards.length && !cards.length}}" class="content-inline-empty">暂时没有匹配的自在体验</view>
    <view wx:if="{{!loading && !allCards.length}}" class="content-city-empty"><text>这里还没有奇灯</text><strong>请帮我们找到这座城市的奇灯新遇官</strong><button class="content-primary-action" bindtap="applyCreator">申请奇灯新遇官</button><button class="content-secondary-action" bindtap="contact">联系奇灯</button></view>
    <view wx:if="{{loading}}" class="content-inline-empty">正在更新城市体验</view>
  </view>
  <view wx:if="{{filterOpen}}" class="content-filter-backdrop" bindtap="closeFilter"><view class="content-filter-sheet" catchtap="keepSheetOpen"><view class="content-sheet-handle"></view><view class="content-sheet-heading"><view><text>更多探索</text><strong>这次想怎么体验？</strong></view><button class="content-sheet-close" bindtap="closeFilter" aria-label="关闭"><image src="/assets/icons/close-ink.svg" mode="aspectFit"/></button></view><scroll-view class="content-sheet-scroll" scroll-y enhanced show-scrollbar="{{false}}"><view class="content-filter-group"><text>使用场景</text><view class="content-filter-options"><button wx:for="{{sceneChoices}}" wx:key="*this" class="{{scene === item ? 'active' : ''}}" data-value="{{item}}" bindtap="selectScene">{{item}}</button></view></view></scroll-view><view class="content-sheet-actions"><button class="content-sheet-secondary" bindtap="clearFilters">清除</button><button class="content-sheet-primary" bindtap="applyFilters">发现新遇</button></view></view></view>
  <consumer-tabs active="self" immersive />
</view>
