@import "../creator-profile/creator-profile.wxss";

.creator-project-form { padding-bottom: 210rpx; background: var(--surface-translucent); }
.project-status { padding: 18rpx 22rpx; border: 1rpx solid var(--line); border-radius: var(--radius-default); background: var(--green-soft); color: var(--ink-soft); font-size: var(--type-caption); line-height: 1.45; }
.project-library { padding-bottom: 30rpx; border-bottom: 1rpx solid var(--line); }
.project-library-heading { display: grid; gap: 7rpx; }
.new-project-button { width: 100%; min-height: 96rpx; padding: 0 24rpx; border: 1rpx solid var(--accent); border-radius: var(--radius-default); background: var(--accent); color: var(--on-accent); display: flex; align-items: center; justify-content: center; gap: 12rpx; font-size: var(--type-card); font-weight: var(--weight-card); text-decoration: none !important; box-shadow: none; }
.new-project-button image { width: 40rpx; height: 40rpx; }
.new-project-button[disabled] { opacity: .45; }
.history-heading { min-height: 52rpx; display: flex; align-items: center; justify-content: space-between; color: var(--ink-soft); font-size: var(--type-caption); font-weight: var(--weight-semibold); }
.history-list { display: grid; gap: 18rpx; }
.history-card { padding: 18rpx; border: 1rpx solid var(--line-strong); border-radius: var(--radius-default); display: grid; grid-template-columns: 132rpx minmax(0, 1fr); gap: 18rpx; background: var(--white); }
.history-card.displayed { background: var(--green-soft); }
.history-image { width: 132rpx; height: 165rpx; border: 1rpx solid var(--line); border-radius: var(--radius-sm); overflow: hidden; background: var(--paper); }
.history-image image, .history-image view { width: 100%; height: 100%; }
.history-image view { padding: 8rpx; display: flex; align-items: center; justify-content: center; color: var(--ink-soft); font-size: var(--type-micro); text-align: center; }
.history-copy { min-width: 0; display: grid; align-content: center; gap: 10rpx; }
.history-title { min-width: 0; overflow: hidden; font-size: var(--type-card); line-height: 1.3; font-weight: var(--weight-semibold); white-space: nowrap; text-overflow: ellipsis; }
.history-intro { overflow: hidden; color: var(--ink-soft); font-size: var(--type-caption); line-height: 1.4; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; }
.history-status { justify-self: start; min-height: 42rpx; padding: 6rpx 10rpx; border: 1rpx solid var(--line); border-radius: var(--radius-sm); background: var(--surface); color: var(--ink-soft); display: flex; align-items: center; font-size: var(--type-micro); line-height: 1.2; font-weight: var(--weight-semibold); }
.history-actions { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(3, 1fr); gap: 10rpx; }
.history-actions button { min-width: 0; height: 72rpx; padding: 0 8rpx; border: 1rpx solid var(--line-strong); border-radius: var(--radius-sm); background: var(--surface); color: var(--ink); display: flex; align-items: center; justify-content: center; font-size: var(--type-caption); line-height: 1.2; font-weight: var(--weight-semibold); white-space: nowrap; }
.history-actions .display-action.active { background: var(--green); opacity: 1; }
.history-actions .delete-action { color: var(--red); }
.project-empty { min-height: 116rpx; border: 1rpx dashed var(--line); border-radius: var(--radius-default); display: flex; align-items: center; justify-content: center; color: var(--ink-soft); }
.project-editor { scroll-margin-top: 250rpx; }
.date-heading { min-height: 46rpx; display: flex; align-items: center; justify-content: space-between; }
.date-heading > view { min-width: 0; display: grid; gap: 6rpx; }
.date-heading button { min-height: 46rpx; padding: 0 10rpx; border: 0; background: transparent; color: var(--green-dark); font-size: var(--type-caption); text-decoration: underline; }
.schedule-add { display: grid; grid-template-columns: minmax(0, 1fr) 150rpx; gap: 12rpx; }
.schedule-add .secondary-button { min-height: 88rpx; }
.project-number-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16rpx; }
.project-number-grid.two .field:last-child { grid-column: auto; }
.field-textarea.compact { min-height: 150rpx; }
.project-tags { border-top: 1rpx solid var(--line); }
.project-tag-group { border-bottom: 1rpx solid var(--line); }
.project-tag-selector { width: 100%; min-height: 104rpx; padding: 16rpx 0; border: 0; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; background: transparent; color: var(--text); text-align: left; }
.project-tag-selector > view:first-child { min-width: 0; display: grid; gap: 7rpx; }
.project-tag-selector > view:first-child text:first-child { color: var(--ink); font-size: var(--type-body); line-height: var(--line-body); font-weight: var(--weight-medium); }
.project-tag-selector > view:first-child text:last-child { overflow: hidden; color: var(--muted); font-size: var(--type-caption); line-height: var(--line-caption); white-space: nowrap; text-overflow: ellipsis; }
.project-tag-selector > view:last-child { flex: none; display: flex; align-items: center; gap: 12rpx; color: var(--muted); font-size: var(--type-card); }
.project-tag-selector > view:last-child image { width: 32rpx; height: 32rpx; }
.project-tag-selector > view:last-child text:first-child { min-width: 38rpx; height: 38rpx; padding: 0 8rpx; border-radius: var(--radius-pill); display: flex; align-items: center; justify-content: center; background: var(--accent-soft); color: var(--accent-pressed); font-size: var(--type-micro); }
.project-tag-options { padding: 0 0 24rpx; display: grid; gap: 16rpx; }
.project-tag-options > .muted, .project-tag-empty { font-size: var(--type-caption); line-height: var(--line-caption); }
.project-tag-empty { color: var(--muted); }
.application-tag-link { justify-self: start; min-height: var(--layout-touch-target); margin: -4rpx 0 12rpx; padding: 0; border: 0; display: inline-flex; align-items: center; gap: 8rpx; background: transparent; color: var(--accent-pressed); font-size: var(--type-caption); line-height: var(--line-caption); font-weight: var(--weight-card); }
.application-tag-link image { width: 28rpx; height: 28rpx; transform: rotate(180deg); }
.operation-section, .operation-fields { display: grid; gap: 16rpx; }
.operation-section { padding-top: 24rpx; border-top: 1rpx solid var(--line); }
.operation-toggle, .rule-ack { width: 100%; padding: 18rpx; border: 1rpx solid var(--line-strong); border-radius: var(--radius-default); display: grid; grid-template-columns: 40rpx minmax(0, 1fr); align-items: center; gap: 14rpx; background: var(--surface); color: var(--ink); text-align: left; }
.operation-toggle.selected, .rule-ack.selected { border-color: var(--warning); background: var(--warning-soft); }
.operation-toggle > view:first-child, .rule-ack > view:first-child { width: 36rpx; height: 36rpx; border: 1rpx solid var(--line-strong); display: grid; place-items: center; background: var(--paper); font-size: var(--type-micro); }
.operation-toggle > view:first-child image, .rule-ack > view:first-child image { width: 26rpx; height: 26rpx; }
.operation-toggle > view:last-child { min-width: 0; display: grid; gap: 7rpx; }
.operation-toggle > view:last-child text:first-child { font-size: var(--type-body); font-weight: var(--weight-semibold); }
.operation-toggle > view:last-child text:last-child, .rule-ack > text { color: var(--ink-soft); font-size: var(--type-micro); line-height: 1.5; }
.operation-fields { padding: 4rpx 0 14rpx 54rpx; }
.operation-current { min-height: 64rpx; padding: 10rpx 14rpx; border-left: 2rpx solid var(--green); display: flex; align-items: center; justify-content: space-between; background: var(--green-soft); font-size: var(--type-caption); }
.project-image-section { display: grid; gap: 18rpx; }
.project-image-heading { display: grid; gap: 8rpx; }
.project-image-heading .muted { font-size: var(--type-caption); line-height: var(--line-caption); }
.activity-image-line { min-height: 275rpx; display: grid; grid-template-columns: 220rpx minmax(0, 1fr); align-items: center; gap: 20rpx; }
.activity-image-line .project-image-preview, .activity-image-line .project-image-placeholder { width: 220rpx; height: 275rpx; padding: 0; border: 1rpx solid var(--line); border-radius: var(--radius-sm); overflow: hidden; background: var(--paper); }
.activity-image-line .project-image-preview { position: relative; }
.activity-image-line .project-image-preview image { width: 100%; height: 100%; }
.activity-image-line .project-image-placeholder { padding: 8rpx; display: flex; align-items: center; justify-content: center; color: var(--ink-soft); font-size: var(--type-micro); text-align: center; }
.project-image-actions { display: grid; grid-template-columns: 1fr; gap: 12rpx; }
.activity-image-line .project-image-actions button { min-width: 0; min-height: 82rpx; padding: 12rpx 16rpx; border: 1rpx solid var(--line-strong); border-radius: var(--radius-default); background: var(--surface); color: var(--ink); display: flex; align-items: center; justify-content: center; font-size: var(--type-secondary); line-height: 1.2; font-weight: var(--weight-semibold); }
.activity-image-line .project-image-actions .image-change-action { background: var(--green-soft); }
.image-source-note { position: absolute; left: 10rpx; right: 10rpx; bottom: 10rpx; min-height: 42rpx; padding: 5rpx 8rpx; border-radius: var(--radius-sm); display: flex; align-items: center; justify-content: center; background: var(--surface-translucent); color: var(--text); font-size: var(--type-micro); line-height: var(--line-micro); }
.publish-actions { display: grid; grid-template-columns: .8fr 1.2fr; gap: 14rpx; }
