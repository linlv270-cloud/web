@import "../venue-detail/venue-detail.wxss";

.detail-page { background: var(--paper); color: var(--text); }
.detail-hero { width: 100%; aspect-ratio: 4 / 5; overflow: hidden; position: relative; background: var(--surface-soft); color: var(--on-dark); }
.detail-hero-image { position: absolute; z-index: 0; inset: 0; width: 100%; height: 100%; }
.detail-hero-shade { position: absolute; z-index: 1; inset: 0; background: var(--image-shade); pointer-events: none; }
.detail-hero brand-header { position: relative; z-index: 4; }
.detail-hero-toolbar { position: relative; z-index: 3; min-height: 88rpx; padding: 8rpx var(--layout-page-gutter); display: flex; align-items: center; gap: var(--space-3); }
.detail-hero-toolbar .page-back { margin: 0; border-color: var(--dark-hairline); background: var(--glass-dark); }
.detail-hero-toolbar > text { color: var(--dark-text-soft); font-size: var(--type-secondary); line-height: var(--line-secondary); }
.detail-hero-copy { position: absolute; z-index: 3; right: var(--layout-page-gutter); bottom: var(--space-6); left: var(--layout-page-gutter); display: grid; gap: var(--space-2); }
.detail-hero-copy text:first-child { color: var(--dark-text-soft); font-size: var(--type-micro); line-height: var(--line-micro); }
.detail-hero-copy text:nth-child(2) { max-width: 620rpx; color: var(--on-dark); font-family: var(--font-sans); font-size: var(--type-display); line-height: var(--line-display); font-weight: var(--weight-display); }
.detail-hero-copy text:last-child { color: var(--dark-text-soft); font-size: var(--type-secondary); line-height: var(--line-secondary); }
.detail-content { padding-top: var(--space-6); }
.creator-public-card { display: grid; gap: 18rpx; }
.creator-public-head { display: grid; grid-template-columns: 96rpx minmax(0, 1fr); align-items: center; gap: 18rpx; }
.creator-public-head image { width: 96rpx; height: 120rpx; border: 1rpx solid var(--line-strong); border-radius: var(--radius-default); }
.creator-public-head image.creator-logo { height: 96rpx; }
.creator-public-head > view { min-width: 0; display: grid; gap: 6rpx; }
.creator-public-head > view > text:first-child { color: var(--muted); font-size: var(--type-micro); line-height: var(--line-micro); }
.creator-public-head .creator-public-name { color: var(--ink); font-size: var(--type-card); line-height: var(--line-card); font-weight: var(--weight-card); }
.creator-public-head text:last-child { color: var(--ink-soft); font-size: var(--type-caption); line-height: 1.5; }
.detail-sticky.double { grid-template-columns: .78fr 1.5fr; }
.contact-creator-button { white-space: nowrap; }
.contact-creator-button[disabled] { border-color: var(--line); background: var(--surface-soft); color: var(--faint); }
.contact-backdrop { position: fixed; z-index: 10020; inset: 0; display: flex; align-items: flex-end; background: var(--scrim); }
.contact-sheet { width: 100%; max-height: calc(100vh - 100rpx); padding: 14rpx var(--layout-page-gutter) calc(30rpx + env(safe-area-inset-bottom)); border-radius: var(--radius-default) var(--radius-default) 0 0; display: grid; gap: var(--space-4); background: var(--paper); color: var(--ink); box-shadow: 0 -20rpx 56rpx var(--shadow-soft); }
.contact-sheet-handle { width: 72rpx; height: 6rpx; margin: 0 auto 4rpx; border-radius: var(--radius-pill); background: var(--line-strong); }
.contact-sheet-heading { min-width: 0; display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
.contact-sheet-heading > view { min-width: 0; display: grid; gap: 6rpx; }
.contact-sheet-heading > view > text:first-child { color: var(--muted); font-size: var(--type-micro); line-height: var(--line-micro); }
.contact-sheet-heading .serif { font-size: var(--type-section); line-height: var(--line-section); font-weight: var(--weight-section); }
.contact-sheet-heading button { width: 72rpx; height: 72rpx; margin: 0; padding: 18rpx; border: 1rpx solid var(--line); border-radius: var(--radius-default); background: var(--surface); }
.contact-sheet-heading button image { width: 100%; height: 100%; }
.contact-reminder { padding: 20rpx; border: 1rpx solid var(--line); border-radius: var(--radius-default); background: var(--green-soft); color: var(--ink); font-size: var(--type-body); line-height: var(--line-body); }
.contact-phone { min-height: 104rpx; padding: 16rpx 20rpx; border-top: 1rpx solid var(--line-strong); border-bottom: 1rpx solid var(--line-strong); display: flex; align-items: center; justify-content: space-between; gap: var(--space-3); }
.contact-phone text:first-child { color: var(--muted); font-size: var(--type-caption); line-height: var(--line-caption); }
.contact-phone text:last-child { color: var(--ink); font-size: var(--type-card); line-height: var(--line-card); font-weight: var(--weight-card); }
.contact-actions { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--space-2); }
