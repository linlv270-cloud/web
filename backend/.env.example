DATA_DIR=/opt/tde/data
PUBLIC_SITE_URL=https://tde.thedesignexpo.org.cn
# The existing mini-program API remains on the old service line and is not part of this deployment.
WECHAT_MINI_APP_ID=
WECHAT_MINI_APP_SECRET=
MINI_AUTH_MOCK=false
# Optional: only needed if GPS coordinates should be converted to province/city/district.
TENCENT_MAP_KEY=
TENCENT_MAP_REQUIRED=false
# Enterprise WeChat is used only for internal platform notifications. Secrets stay on the server.
WECOM_CORP_ID=
WECOM_DIRECTORY_SECRET=
WECOM_APP_AGENT_ID=
WECOM_APP_SECRET=
SMS_ENABLED=false
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
SMS_VERIFICATION_SIGN_NAME=
SMS_VERIFICATION_TEMPLATE_CODE=
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional one-time bootstrap code for an isolated new database. Leave blank after setup.
QIDENG_BOOTSTRAP_INVITE_CODE=
